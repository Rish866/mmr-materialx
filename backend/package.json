{
  "name": "mmr-materialx-backend",
  "version": "0.1.0",
  "description": "MMR MaterialX — hyper-local B2B raw material exchange API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "node scripts/run-tests.js",
    "test:watch": "node --test --watch --test-concurrency=1 test/auth.test.js test/listings.test.js test/misc.test.js test/uploads.test.js",
    "lint": "node scripts/check-syntax.js",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=18 <23"
  }
}
