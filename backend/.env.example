# ---- Server ----
PORT=3000

# ---- Database (managed Postgres: Supabase / Neon / Railway) ----
DATABASE_URL=postgresql://user:password@host:5432/mmr

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
OTP_TTL_MINUTES=5

# ---- SMS provider (MSG91 recommended for India / DLT compliant) ----
# Leave SMS_PROVIDER=console in dev to print OTPs to the server log instead of sending SMS.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MMRMTX
MSG91_DLT_TEMPLATE_ID=

# ---- Image uploads ----
# UPLOAD_PROVIDER: local (dev no-op, keeps local URI) | cloudinary | supabase
UPLOAD_PROVIDER=local

# Cloudinary (signed direct upload). Secret stays server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=mmr-listings

# Supabase Storage (signed upload URL). Use the SERVICE ROLE key, server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=listings
