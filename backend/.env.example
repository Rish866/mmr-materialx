# ============================================================
# MMR MaterialX backend — environment template
# Copy to .env and fill in. NEVER commit a real .env (it is gitignored).
# Placeholder values only below — no real credentials.
# ============================================================

# ---- Runtime ----
# development | test | production. In production the server REFUSES to start
# with an insecure/incomplete config (see src/config.js).
NODE_ENV=development
PORT=3000

# ---- Database (managed Postgres: Supabase / Neon / Railway) ----
DATABASE_URL=postgresql://user:password@host:5432/mmr
# Set to "disable" only for local/socket Postgres without SSL.
PGSSL=

# ---- Auth ----
# REQUIRED in production, must be >=32 chars and not a known weak value.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (jsonwebtoken format). Default 90d.
JWT_TTL=90d
OTP_TTL_MINUTES=5

# ---- SMS provider ----
# console = print OTP to server log (DEV ONLY; refused in production).
# msg91   = send real SMS (India / DLT compliant) — required in production.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MMRMTX
MSG91_DLT_TEMPLATE_ID=

# ---- Image uploads ----
# local = dev no-op (keeps local URI; refused in production).
# cloudinary | supabase = signed, direct client->storage uploads.
UPLOAD_PROVIDER=local
# Cloudinary (secret stays server-side; never sent to the app)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=mmr-listings
# Supabase Storage (use the SERVICE ROLE key, server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=listings

# ---- CORS ----
# Comma-separated allowlist of browser origins allowed to call the API, e.g.
# https://app.mmrmaterialx.com,https://admin.mmrmaterialx.com
# Empty in dev = allow all; empty in prod = deny unknown browser origins.
# (The mobile app sends no Origin header and is always allowed.)
CORS_ORIGINS=

# ---- Request limits ----
JSON_BODY_LIMIT=1mb

# ---- Rate limits (all optional; sensible defaults in src/config.js) ----
# OTP SEND limits
RL_OTP_SEND_IP_MAX=10               # max OTP sends per IP per window
RL_OTP_SEND_IP_WINDOW_SEC=3600
RL_OTP_SEND_PHONE_MAX=5             # max OTP sends per phone per window
RL_OTP_SEND_PHONE_WINDOW_SEC=3600
RL_OTP_SEND_COOLDOWN_SEC=30         # min seconds between sends to one phone
# OTP VERIFY limits (brute-force protection)
RL_OTP_VERIFY_PHONE_MAX=10          # max verify attempts per phone per window
RL_OTP_VERIFY_WINDOW_SEC=900
RL_OTP_MAX_ATTEMPTS=5               # max wrong guesses against a single code
